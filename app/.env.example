# For a physical phone, copy this file to .env and replace the host with the
# development computer's IPv4 address on the same Wi-Fi (for example:
# http://192.168.110.200:4242). Leave empty to auto-detect the Expo Go host.
EXPO_PUBLIC_API_URL=
# Required by EAS builds for Expo push token generation.
EXPO_PUBLIC_EAS_PROJECT_ID=
